#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/*
 * wings42 v3 (Daily Craft) - 3x6 + 3 thumb keys per half, 42 keys total.
 * Pins taken from QMK dailycraft/wings42/rev2 (COL2ROW).
 *
 * Matrix: 4 rows x 12 columns (left = cols 0-5, right = cols 6-11)
 *   Rows 0-2 : main 3x6 block
 *   Row  3   : thumb keys (left: cols 3,4,5 / right: cols 6,7,8)
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* QMK rows: D4, C6, D7, E6 */
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        /* w h x y (1/100 key units) - positions from QMK layout, same order as the transform map */
        keys
            /* row 0 */
            = <&key_physical_attrs 100 100    0  88 0 0 0>
            , <&key_physical_attrs 100 100  100  63 0 0 0>
            , <&key_physical_attrs 100 100  200  38 0 0 0>
            , <&key_physical_attrs 100 100  300   0 0 0 0>
            , <&key_physical_attrs 100 100  400   0 0 0 0>
            , <&key_physical_attrs 100 100  500  13 0 0 0>
            , <&key_physical_attrs 100 100  900  13 0 0 0>
            , <&key_physical_attrs 100 100 1000   0 0 0 0>
            , <&key_physical_attrs 100 100 1100   0 0 0 0>
            , <&key_physical_attrs 100 100 1200  38 0 0 0>
            , <&key_physical_attrs 100 100 1300  63 0 0 0>
            , <&key_physical_attrs 100 100 1400  88 0 0 0>
            /* row 1 */
            , <&key_physical_attrs 100 100    0 188 0 0 0>
            , <&key_physical_attrs 100 100  100 163 0 0 0>
            , <&key_physical_attrs 100 100  200 138 0 0 0>
            , <&key_physical_attrs 100 100  300 100 0 0 0>
            , <&key_physical_attrs 100 100  400 100 0 0 0>
            , <&key_physical_attrs 100 100  500 113 0 0 0>
            , <&key_physical_attrs 100 100  900 113 0 0 0>
            , <&key_physical_attrs 100 100 1000 100 0 0 0>
            , <&key_physical_attrs 100 100 1100 100 0 0 0>
            , <&key_physical_attrs 100 100 1200 138 0 0 0>
            , <&key_physical_attrs 100 100 1300 163 0 0 0>
            , <&key_physical_attrs 100 100 1400 188 0 0 0>
            /* row 2 */
            , <&key_physical_attrs 100 100    0 288 0 0 0>
            , <&key_physical_attrs 100 100  100 263 0 0 0>
            , <&key_physical_attrs 100 100  200 238 0 0 0>
            , <&key_physical_attrs 100 100  300 200 0 0 0>
            , <&key_physical_attrs 100 100  400 200 0 0 0>
            , <&key_physical_attrs 100 100  500 213 0 0 0>
            , <&key_physical_attrs 100 100  900 213 0 0 0>
            , <&key_physical_attrs 100 100 1000 200 0 0 0>
            , <&key_physical_attrs 100 100 1100 200 0 0 0>
            , <&key_physical_attrs 100 100 1200 238 0 0 0>
            , <&key_physical_attrs 100 100 1300 263 0 0 0>
            , <&key_physical_attrs 100 100 1400 288 0 0 0>
            /* thumbs */
            , <&key_physical_attrs 100 100  400 300 0 0 0>
            , <&key_physical_attrs 100 100  500 313 0 0 0>
            , <&key_physical_attrs 100 100  600 338 0 0 0>
            , <&key_physical_attrs 100 100  800 338 0 0 0>
            , <&key_physical_attrs 100 100  900 313 0 0 0>
            , <&key_physical_attrs 100 100 1000 300 0 0 0>
            ;
    };
};
